</joint>

<!-- Arm 4 joints -->
<joint name="base_to_hub_4" type="revolute">
    <parent link="base_link" />
    <child link="hub_link_4" />
    <origin xyz="1.17 -1.17 0.7" rpy="0 0 -2.3562" />
    <axis xyz="0 0 1" />
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0" />
</joint>
<joint name="hub_to_arm_4" type="prismatic">
    <parent link="hub_link_4" />
    <child link="arm_link_4" />
    <origin xyz="0 0 0.285" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
